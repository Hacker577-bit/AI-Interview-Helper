FLASK_APP=run.py
FLASK_ENV=production
SECRET_KEY=generate-a-random-64-char-string
DATABASE_URL=sqlite:///interview_ai.db
# Turso (serverless SQLite) - replace with your values from Step 1
TURSO_DATABASE_URL=libsql://interview-ai-<your-org>.turso.io
TURSO_AUTH_TOKEN=eyJ...your-token...
OPENAI_API_KEY=sk-your-openai-key
