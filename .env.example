# Database (Supabase PostgreSQL)
# Get these from your Supabase project Settings > Database > Connection string
# Use the "Transaction" pooler for DATABASE_URL (port 6543)
# Use the "Session" pooler for DIRECT_DATABASE_URL (port 5432) - needed for migrations
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Auth
JWT_SECRET="generate-a-random-64-char-string-here"

# AI Question Generation - Groq (RECOMMENDED) - drives interview questions from the job description
# Get a free key from https://console.groq.com (key starts with gsk-...). Used automatically when
# set, and takes priority over Grok and OpenAI.
GROQ_API_KEY="gsk-..."

# Grok / xAI (optional - used when GROQ_API_KEY is not set)
# Get a key from https://console.x.ai (key starts with xai-...)
GROK_API_KEY="xai-..."
# XAI_API_KEY="xai-..."   # alternative name accepted

# OpenAI (optional - used only when neither GROQ nor GROK key is set)
OPENAI_API_KEY="sk-..."

# Stripe (optional - app works without it)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_PRO_MONTHLY_PRICE_ID="price_..."
STRIPE_PRO_YEARLY_PRICE_ID="price_..."

# Admin
ADMIN_EMAIL="admin@yourdomain.com"

# App
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
